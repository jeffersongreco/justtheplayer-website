{
  "name": "just-the-player",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "lefthook": "^2.1.5",
    "turbo": "^2.9.6",
    "ultracite": "^7.5.8"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:website": "turbo dev --filter=@just-the-player/website",
    "dev:ar": "turbo dev --filter=@headless-uai/attention-requester",
    "dev:movable": "turbo dev --filter=@headless-uai/movable",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "size": "turbo size",
    "version": "turbo version --filter='./packages/*'",
    "changelog:ar": "git cliff --config cliff.toml --include-path 'packages/attention-requester/**' -o packages/attention-requester/CHANGELOG.md",
    "changelog:movable": "git cliff --config cliff.toml --include-path 'packages/movable/**' -o packages/movable/CHANGELOG.md",
    "prepare": "lefthook install"
  },
  "workspaces": ["apps/*", "packages/*"]
}
