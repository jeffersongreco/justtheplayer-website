{
  "name": "just-the-player",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "lefthook": "^2.1.4",
    "turbo": "^2.6.3",
    "ultracite": "6.3.10"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:website": "turbo dev --filter=@just-the-player/website",
    "dev:ar": "turbo dev --filter=@headless-uai/attention-requester",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "test": "turbo test",
    "prepare": "lefthook install"
  }
}
