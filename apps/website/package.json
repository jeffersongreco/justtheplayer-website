{
  "name": "@just-the-player/website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && ultracite check",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "lint": "ultracite fix",
    "optimize-images": "bun ./media/optimize.ts",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@headless-uai/attention-requester": "workspace:*",
    "@headless-uai/movable": "workspace:*",
    "@mux/mux-player": "^3.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/glob": "^9.0.0",
    "@types/sharp": "^0.32.0",
    "glob": "^13.0.0",
    "sharp": "^0.34.5",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "ultracite": "6.3.10",
    "vite": "^7.2.2",
    "wrangler": "^4.54.0"
  }
}
