{
  "name": "@just-the-player/website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
