    "@headless-uai/movable": "workspace:*",
    "@mux/mux-player": "^3.11.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/glob": "^9.0.0",
    "@types/sharp": "^0.32.0",
    "glob": "^13.0.0",
    "sharp": "^0.34.5",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "wrangler": "^4.82.2"
  }
