{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [".svelte-kit/**"],
      "inputs": ["src/**", "static/**", "vite.config.ts", "svelte.config.js"]
    },
    "check": {
      "outputs": [] 
    },
    "lint": {
      "outputs": []
    },
    "optimize-images": {
      "inputs": ["media/src/**"],
      "outputs": ["media/dist/**"], 
      "cache": true
    }
  }
}