{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "optimize-images": {
      "inputs": ["media/src/**"],
      "outputs": ["media/dist/**"],
      "cache": true
    }
  }
}
