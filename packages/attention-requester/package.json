    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "axe-core": "^4.11.3",
    "jsdom": "^29.0.2",
    "size-limit": "^12.1.0",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
