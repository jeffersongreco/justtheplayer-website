{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/svelte"
  ],
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": true
    }
  },
  // Architecture §9 requires PascalCase domain-prefixed filenames
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.svelte"
      ],
      "css": {
        "formatter": {
          "enabled": true
        },
        "linter": {
          "enabled": true
        },
        "parser": {
          "cssModules": true
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnknownPseudoClass": "off"
          },
          // Svelte templates use {(x = y, '')} to capture snippet params — idiomatic pattern
          // bind:this assigns variables that Biome can't see in the template — false positive
          "suspicious": {
            "noAssignInExpressions": "off",
            "noUnassignedVariables": "off"
          },
          "complexity": {
            "noCommaOperator": "off"
          }
        }
      }
    }
  ]
}
