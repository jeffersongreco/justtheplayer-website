{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/svelte"
  ],
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.svelte"
      ],
      "css": {
        "formatter": {
          "enabled": true
        },
        "linter": {
          "enabled": true
        },
        "parser": {
          "cssModules": true
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnknownPseudoClass": "off"
          }
        }
      }
    }
  ]
}
